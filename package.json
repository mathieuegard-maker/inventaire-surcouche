{
  "name": "inventaire-surcouche",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "start:server": "tsx server/index.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "cf:dev": "npm run build && wrangler pages dev dist",
    "cf:migrate:local": "wrangler d1 migrations apply biblio-catalog-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply biblio-catalog-db --remote",
    "cf:deploy": "npm run build && wrangler pages deploy dist --project-name biblio-collection-pwa --branch main --commit-dirty=true"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.8.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.162.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "better-sqlite3": "^13.2.0",
    "dexie": "^4.4.2",
    "hono": "^4.13.19",
    "html5-qrcode": "^2.3.8",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  }
}
