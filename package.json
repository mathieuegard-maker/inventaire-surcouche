{
  "name": "biblio-collection-v2",
  "private": true,
  "version": "2.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "start:server": "tsx src/server/index.ts",
    "typecheck:client": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck": "npm run typecheck:client && npm run typecheck:server"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.8.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/zod-validator": "^0.4.3",
    "@lucide/vue": "^1.82.0",
    "better-sqlite3": "^13.2.0",
    "dexie": "^4.4.2",
    "hono": "^4.13.19",
    "html5-qrcode": "^2.3.8",
    "nodemailer": "^10.6.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.20",
    "sharp": "^0.35.5",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7",
    "zod": "^3.24.2"
  }
}
