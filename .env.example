# Configuration serveur auto-hébergé — Biblio Collection V2
# Copier ce fichier vers `.env` et renseigner vos secrets avant `docker compose -f docker-compose.tunnel.yml up -d --build`.

# E-mail du compte automatiquement promu Administrateur sur base vierge
ADMIN_EMAIL=

# Secret de signature des sessions (générer avec : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-openssl-rand-hex-32

# Clé API Google Gemini (pour l'OCR Photo IA serveur)
GEMINI_API_KEY=

# Envoi d'e-mails (récupération de mot de passe + digests sorties) via Resend (optionnel)
RESEND_API_KEY=
MAIL_FROM=Biblio Collection <noreply@mathieuegardtest.fr>

# Notifications Web Push VAPID (optionnel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:contact@mathieuegardtest.fr

# Stockage & Planificateur interne
DATA_DIR=./data
CRON_ENABLED=true
CRON_NIGHTLY_HOUR=2
