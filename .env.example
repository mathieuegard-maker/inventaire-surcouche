# Configuration serveur auto-hébergé — Biblio Collection V2
# Copier ce fichier vers `.env` et renseigner vos secrets avant `docker compose -f docker-compose.tunnel.yml up -d --build`.

# E-mail du compte automatiquement promu Administrateur sur base vierge
ADMIN_EMAIL=

# Secret de signature des sessions (générer avec : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-openssl-rand-hex-32

# Clé API Google Gemini (pour l'OCR Photo IA serveur)
GEMINI_API_KEY=

# Envoi d'e-mails (récupération de mot de passe, digests sorties, formulaire de contact)
# Option 1 (prioritaire) : SMTP authentifié (ex. Infomaniak mail.infomaniak.com:465)
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@mabibliocloud.fr
SMTP_PASS=
CONTACT_EMAIL=contact@mabibliocloud.fr

# Option 2 (secours si SMTP non renseigné) : Resend API
RESEND_API_KEY=
MAIL_FROM=Ma Bibliothèque Cloud <contact@mabibliocloud.fr>

# Notifications Web Push VAPID (optionnel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:contact@mabibliocloud.fr

# Quota Photo IA mensuel par utilisateur
MONTHLY_AI_QUOTA=100

# Stockage & Planificateur interne
DATA_DIR=./data
CRON_ENABLED=true
CRON_NIGHTLY_HOUR=2
