# Configuration serveur auto-hébergé (Biblio Collection PWA)
# Copier ce fichier vers `.env` et renseigner vos secrets avant `docker compose up -d --build`.

# Secret de signature des sessions (générer avec : openssl rand -hex 32)
JWT_SECRET=changez-moi-avec-openssl-rand-hex-32

# Clé API Google Gemini (pour l'OCR Photo IA / Canal 4)
GEMINI_API_KEY=

# Envoi d'e-mails (récupération de mot de passe + digests sorties) via Resend (optionnel)
RESEND_API_KEY=
MAIL_FROM=Biblio Collection <noreply@mathieuegardtest.fr>

# Notifications Web Push VAPID (optionnel)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_JWK=
VAPID_SUBJECT=mailto:contact@mathieuegardtest.fr

# Planificateur interne (remplace le Worker CRON Cloudflare)
CRON_ENABLED=true
CRON_INTERVAL_MINUTES=60
